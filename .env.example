PORT=3000
LTC_ADMIN_USER=admin
LTC_ADMIN_PASSWORD=change-this-password
LTC_TOKEN_SECRET=change-this-to-a-long-random-secret

# Optional: enable hybrid AI (Gemini + local deterministic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=12000
# Alternative names are also supported: GOOGLE_GEMINI_API_KEY, GOOGLE_API_KEY

# AI concurrency / queue tuning (multi-user support)
AI_CONTEXT_CACHE_MS=2000
AI_MAX_CONCURRENT=8
AI_MAX_CONCURRENT_PER_CLIENT=2
AI_MAX_QUEUE=100
AI_QUEUE_TIMEOUT_MS=15000

# Security hardening
REQUEST_BODY_LIMIT=1mb
REQUIRE_AJAX_HEADER=1
# Optional comma-separated allowlist (e.g. http://localhost:3000,https://example.com)
ALLOWED_ORIGINS=
# Optional: custom API/Auth prefixes (change both together)
API_PREFIX=/api
AUTH_PREFIX=/auth
# If deploy behind reverse proxy/load balancer set trusted hop count (e.g. 1)
TRUST_PROXY_HOPS=0
# Temporary request debug logs (disable in production)
DEBUG_REQUESTS=0
# Auto block IP when request spam is detected
IP_BLOCK_ENABLED=1
IP_BLOCK_WINDOW_MS=60000
IP_BLOCK_MAX_HITS=240
IP_BLOCK_DURATION_MS=600000
TABLE_MAX_ROWS=50000
TABLE_MAX_PAYLOAD_BYTES=8388608
TABLE_MAX_DEPTH=40
