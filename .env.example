PORT=3000

# Optional network and request hardening
HOST=127.0.0.1
REQUEST_BODY_LIMIT=1mb
REQUIRE_AJAX_HEADER=1
ALLOWED_ORIGINS=
API_PREFIX=/api
TRUST_PROXY_HOPS=0
DEBUG_REQUESTS=0

# Optional IP auto-block tuning
IP_BLOCK_ENABLED=1
IP_BLOCK_WINDOW_MS=60000
IP_BLOCK_MAX_HITS=240
IP_BLOCK_DURATION_MS=600000

# Table safety limits
TABLE_MAX_ROWS=50000
TABLE_MAX_PAYLOAD_BYTES=8388608
TABLE_MAX_DEPTH=40
